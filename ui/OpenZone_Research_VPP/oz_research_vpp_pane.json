                  {"hbox": {"name": "ResCols", "w": "fill", "h": "fill", "gap": "$space.column", "children": [
                    {"vbox": {"name": "ResOwnersCol", "w": 600, "gap": "$space.tight", "children": [
                      {"label": {"name": "ResOwnersHead", "h": "$size.hint", "text": "#STR_OZL_ED_OV_HEAD", "font": "small", "color": "$accent"}},
                      {"listbox": {"name": "ResOwners", "h": "fill", "font": "field", "color": "$text",
                        "props": {"style": "NoScrollBar", "title visible": false, "highlight row": true, "lines": 12},
                        "note": "One row per faction the core's registry or a state file knows."}}
                    ]}},
                    {"vbox": {"name": "ResActsCol", "w": 340, "gap": "$space.tight", "children": [
                      {"label": {"name": "ResPicked", "h": "$size.hint", "text": "#STR_OZL_ED_OV_PICK", "font": "small", "color": "$muted"}},
                      {"hrow": {"h": "$size.field", "children": [
                        {"label": {"name": "GrantTypeLbl", "w": 90, "text": "#STR_OZL_ED_OV_PTYPE", "font": "small", "color": "$muted"}},
                        {"field": {"name": "GrantType", "w": 250}}
                      ]}},
                      {"hrow": {"h": "$size.field", "children": [
                        {"label": {"name": "GrantNLbl", "w": 90, "text": "#STR_OZL_ED_OV_AMOUNT", "font": "small", "color": "$muted"}},
